@@ -287,8 +302,76 @@ float AP_Motors6DOF::get_current_limit_max_throttle()
 // includes new scaling stability patch
 // TODO pull code that is common to output_armed_not_stabilizing into helper functions
 // ToDo calculate headroom for rpy to be added for stabilization during full throttle/forward/lateral commands
+// ---- external thruster control (direct_thruster fork) -------------------------
+// Accept a validated 8-channel normalised thrust command. Refused while disabled
+// or while a fault is latched, so a stale/illegal stream can never resume control
+// without an explicit re-enable.
+void AP_Motors6DOF::set_external_thrust(const float thrust[AP_MOTORS_MAX_NUM_MOTORS], uint32_t now_ms)
+{
+    if (_ext_enable == 0 || _ext_fault_latched) {
+        return;
+    }
+    for (uint8_t i = 0; i < AP_MOTORS_MAX_NUM_MOTORS; i++) {
+        _ext_thrust[i] = constrain_float(thrust[i], -1.0f, 1.0f);
+    }
+    _ext_last_ms = now_ms;
+    _ext_have_cmd = true;
+}
+
+void AP_Motors6DOF::clear_external_thrust()
+{
+    for (uint8_t i = 0; i < AP_MOTORS_MAX_NUM_MOTORS; i++) {
+        _ext_thrust[i] = 0.0f;
+    }
+    _ext_have_cmd = false;
+    _ext_last_ms = 0;
+}
+
+bool AP_Motors6DOF::external_thrust_active() const
+{
+    if (_ext_enable == 0 || _ext_fault_latched || !_ext_have_cmd) {
+        return false;
+    }
+    return (AP_HAL::millis() - _ext_last_ms) < (uint32_t)_ext_timeout_ms;
+}
+
+bool AP_Motors6DOF::external_thrust_timed_out() const
+{
+    if (_ext_enable == 0 || !_ext_have_cmd) {
+        return false;
+    }
+    return (AP_HAL::millis() - _ext_last_ms) >= (uint32_t)_ext_timeout_ms;
+}
+
+// Fill _thrust_rpyt_out[] straight from the external command, replacing the mixer.
+// Everything downstream is unchanged: output_to_motors() still forces 1500 unless
+// the spool state is running, then applies calc_thrust_to_pwm() and rc_write().
+void AP_Motors6DOF::output_external_thrusters()
+{
+    for (uint8_t i = 0; i < AP_MOTORS_MAX_NUM_MOTORS; i++) {
+        if (motor_enabled[i]) {
+            // mirrors the final line of the mixers: honour per-motor direction, then clamp
+            _thrust_rpyt_out[i] = constrain_float(_motor_reverse[i] * _ext_thrust[i], -1.0f, 1.0f);
+        }
+    }
+    // mixer saturation flags are meaningless under direct control
+    limit.roll = false;
+    limit.pitch = false;
+    limit.yaw = false;
+    limit.throttle_lower = false;
+    limit.throttle_upper = false;
+}
