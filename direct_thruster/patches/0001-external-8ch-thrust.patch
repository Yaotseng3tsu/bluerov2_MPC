+// direct_thruster fork: watchdog on the external per-thruster command stream.
+//
+// Deliberately different from the pilot-input failsafe above:
+//   - it is NOT compiled out on SITL, so the behaviour can be tested in simulation
+//   - the action is fixed and strict: neutral, disarm, and LATCH the fault
+// Control is never silently handed back to the mixer and the last command is never
+// held. Clearing MOT_EXT_ENABLE releases the latch, so re-entering external control
+// is always an explicit operator action.
+void Sub::failsafe_ext_thrust_check()
+{
+    // external control switched off: release the latch so it can be re-enabled
+    if (!motors.external_thrust_enabled()) {
+        motors.clear_external_fault();
+        failsafe.ext_thrust = false;
+        return;
+    }
+
+    if (!motors.external_thrust_timed_out()) {
+        failsafe.ext_thrust = false;
+        return;
+    }
+
+    if (failsafe.ext_thrust) {
+        return; // only act once
+    }
+
+    failsafe.ext_thrust = true;
+
+    // drop the stale command and refuse further ones until explicitly re-enabled
+    motors.clear_external_thrust();
+    motors.latch_external_fault();
+
+    AP::logger().Write_Error(LogErrorSubsystem::PILOT_INPUT, LogErrorCode::FAILSAFE_OCCURRED);
+    gcs().send_text(MAV_SEVERITY_CRITICAL, "Lost external thrust commands");
+
+    set_neutral_controls();
+    arming.disarm(AP_Arming::Method::PILOT_INPUT_FAILSAFE);
+}
+
 // Internal pressure failsafe check
 // Check if the internal pressure of the watertight electronics enclosure
 // has exceeded the maximum specified by the FS_PRESS_MAX parameter
